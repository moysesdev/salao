# Ambiente: development ou production
NODE_ENV=development
PORT=3000

# Banco de dados PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=salao_db
DB_PASSWORD=suasenha
DB_PORT=5432

# Segredo do JWT (mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cole_aqui_um_segredo_de_32_caracteres_no_minimo

# Reset de senha (usado pelo reset.js)
RESET_EMAIL=gerente@salao.com
RESET_PASSWORD=

# SMTP (opcional - se vazio, o código aparece no console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=